MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false

# Prisma usa a base MySQL/MariaDB principal do CRM.
# Exemplo: mysql://usuario:senha@host:3306/banco
DATABASE_URL=
PRISMA_CONNECTION_LIMIT=2
PRISMA_ACQUIRE_TIMEOUT_MS=10000
PRISMA_CONNECT_TIMEOUT_MS=10000

# Redis e cache distribuido. Se REDIS_URL estiver ausente, o sistema usa fallback local em memoria.
REDIS_ENABLED=false
REDIS_URL=
REDIS_KEY_PREFIX=crm
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1500
REDIS_RETRY_COOLDOWN_MS=30000

# Cache local L1 usado com ou sem Redis para manter resposta rapida.
RUNTIME_CACHE_MAX_ENTRIES=1000
RUNTIME_CACHE_STALE_GRACE_MS=30000

# Protecao de rotas sensiveis.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=600000

AUTH_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
APP_NAME=AG CRM - Sistema Corporativo
