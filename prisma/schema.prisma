generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clientes {
  id             String                 @id @db.VarChar(36)
  nome           String                 @db.VarChar(255)
  cpf            String?                @db.VarChar(20)
  email          String?                @db.VarChar(255)
  telefone       String?                @db.VarChar(20)
  empresa        String?                @db.VarChar(255)
  cargo          String?                @db.VarChar(255)
  tipo           clientes_tipo          @default(residencial)
  endereco       String?                @db.Text
  numero         String?                @db.VarChar(30)
  bairro         String?                @db.VarChar(120)
  cidade         String?                @db.VarChar(100)
  estado         String?                @db.VarChar(2)
  cep            String?                @db.VarChar(10)
  origem         clientes_origem?
  status_funil   clientes_status_funil? @default(lead_novo)
  responsavel_id String?                @db.VarChar(36)
  observacoes    String?                @db.Text
  created_at     DateTime?              @default(now()) @db.Timestamp(0)
  updated_at     DateTime?              @default(now()) @db.Timestamp(0)
  usuarios       usuarios?              @relation(fields: [responsavel_id], references: [id], onUpdate: Restrict, map: "clientes_ibfk_1")
  interacoes     interacoes[]
  propostas      propostas[]
  tarefas        tarefas[]

  @@index([nome, email], map: "idx_clientes_nome_email")
  @@index([responsavel_id], map: "idx_clientes_responsavel")
  @@index([status_funil], map: "idx_clientes_status")
  @@index([status_funil, created_at], map: "idx_clientes_status_created")
  @@index([updated_at], map: "idx_clientes_updated_at")
}

model configuracoes {
  id         String    @id @db.VarChar(36)
  chave      String    @db.VarChar(100)
  scope      String    @default("global") @db.VarChar(20)
  user_id    String    @default("") @db.VarChar(36)
  valor      String    @db.LongText
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)

  @@unique([chave, scope, user_id], map: "unique_config_scope")
}

model email_verification_tokens {
  id         String    @id @db.VarChar(36)
  nome       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  senha_hash String    @db.VarChar(255)
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model interacoes {
  id                  String          @id @db.VarChar(36)
  cliente_id          String          @db.VarChar(36)
  proposta_id         String?         @db.VarChar(36)
  usuario_id          String          @db.VarChar(36)
  tipo                interacoes_tipo
  descricao           String          @db.Text
  dados               String?         @db.LongText
  novo_status         String?         @db.VarChar(60)
  notification_kind   String?         @db.VarChar(60)
  origem              String?         @db.VarChar(80)
  silent_notification Boolean         @default(false)
  created_at          DateTime?       @default(now()) @db.Timestamp(0)
  propostas           propostas?      @relation(fields: [proposta_id], references: [id], map: "fk_interacoes_proposta")
  clientes            clientes        @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "interacoes_ibfk_1")
  usuarios            usuarios        @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "interacoes_ibfk_2")

  @@index([cliente_id], map: "idx_interacoes_cliente")
  @@index([cliente_id, created_at], map: "idx_interacoes_cliente_created")
  @@index([created_at], map: "idx_interacoes_data")
  @@index([proposta_id, created_at], map: "idx_interacoes_proposta_created")
  @@index([tipo, created_at], map: "idx_interacoes_tipo_created")
  @@index([tipo, notification_kind, created_at], map: "idx_interacoes_tipo_notification_created")
  @@index([usuario_id, created_at], map: "idx_interacoes_usuario_created")
}

model login_verification_tokens {
  id         String    @id @db.VarChar(36)
  usuario_id String    @db.VarChar(36)
  email      String    @db.VarChar(255)
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model notification_reads {
  id              String    @id @db.VarChar(36)
  user_id         String    @db.VarChar(36)
  notification_id String    @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.Timestamp(0)

  @@unique([user_id, notification_id], map: "unique_user_notification")
}

model password_reset_tokens {
  id         String    @id @db.VarChar(36)
  usuario_id String    @db.VarChar(36)
  email      String    @db.VarChar(255)
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model proposal_sequences {
  ano           Int       @id
  ultimo_numero Int       @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model proposta_anexos {
  id            String    @id @db.VarChar(36)
  proposta_id   String    @db.VarChar(36)
  nome_original String    @db.VarChar(255)
  nome_arquivo  String    @db.VarChar(255)
  caminho       String    @db.VarChar(500)
  tipo_mime     String    @db.VarChar(150)
  tamanho       BigInt    @default(0)
  conteudo      Bytes?
  usuario_id    String?   @db.VarChar(36)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  propostas     propostas @relation(fields: [proposta_id], references: [id], onDelete: Cascade, map: "fk_proposta_anexos_proposta")
  usuarios      usuarios? @relation(fields: [usuario_id], references: [id], map: "fk_proposta_anexos_usuario")

  @@index([proposta_id], map: "idx_proposta_anexos_proposta")
  @@index([usuario_id], map: "idx_proposta_anexos_usuario")
}

model proposta_comentarios {
  id          String    @id @db.VarChar(36)
  proposta_id String    @db.VarChar(36)
  usuario_id  String?   @db.VarChar(36)
  comentario  String    @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  propostas   propostas @relation(fields: [proposta_id], references: [id], onDelete: Cascade, map: "fk_proposta_comentarios_proposta")
  usuarios    usuarios? @relation(fields: [usuario_id], references: [id], map: "fk_proposta_comentarios_usuario")

  @@index([proposta_id, created_at], map: "idx_proposta_comentarios_proposta_created")
  @@index([usuario_id], map: "idx_proposta_comentarios_usuario")
}

model proposta_servicos {
  id          String    @id @db.VarChar(36)
  proposta_id String    @db.VarChar(36)
  nome        String    @db.VarChar(255)
  ordem       Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  propostas   propostas @relation(fields: [proposta_id], references: [id], onDelete: Cascade, map: "fk_proposta_servicos_proposta")

  @@index([proposta_id, ordem], map: "idx_proposta_servicos_proposta_ordem")
}

model propostas {
  id                                           String                 @id @db.VarChar(36)
  numero                                       String                 @unique(map: "numero") @db.VarChar(50)
  cliente_id                                   String                 @db.VarChar(36)
  responsavel_id                               String                 @db.VarChar(36)
  orcamentista_id                              String?                @db.VarChar(36)
  retificacoes_count                           Int                    @default(0)
  follow_up_base_at                            DateTime?              @db.DateTime(0)
  follow_up_time                               DateTime?              @db.Time(0)
  kanban_order                                 BigInt?
  pos_fechamento_aguardando_contrato_at        DateTime?              @db.DateTime(0)
  pos_fechamento_contrato_feito_at             DateTime?              @db.DateTime(0)
  pos_fechamento_contrato_enviado_at           DateTime?              @db.DateTime(0)
  pos_fechamento_contrato_assinado_at          DateTime?              @db.DateTime(0)
  pos_fechamento_aguardando_pagamento_at       DateTime?              @db.DateTime(0)
  pos_fechamento_pagamento_confirmado_at       DateTime?              @db.DateTime(0)
  pos_fechamento_aguardando_os_at              DateTime?              @db.DateTime(0)
  pos_fechamento_ordem_servico_liberada_at     DateTime?              @db.DateTime(0)
  area_m2                                      Decimal?               @db.Decimal(10, 2)
  perfis_bruto                                 Decimal?               @db.Decimal(10, 2)
  perfis_liquidos                              Decimal?               @db.Decimal(10, 2)
  valor_perfil                                 Decimal?               @db.Decimal(12, 2)
  valor_vidro                                  Decimal?               @db.Decimal(12, 2)
  valor_acessorios                             Decimal?               @db.Decimal(12, 2)
  observacoes_tecnicas                         String?                @db.Text
  titulo                                       String                 @db.VarChar(255)
  material_tag                                 String?                @db.VarChar(80)
  descricao                                    String?                @db.Text
  valor                                        Decimal                @db.Decimal(15, 2)
  desconto                                     Decimal?               @default(0.00) @db.Decimal(5, 2)
  valor_final                                  Decimal                @db.Decimal(15, 2)
  status                                       propostas_status?      @default(novo_cliente)
  validade                                     DateTime?              @db.Date
  servicos                                     String?                @db.LongText
  condicoes                                    String?                @db.Text
  created_at                                   DateTime?              @default(now()) @db.Timestamp(0)
  updated_at                                   DateTime?              @default(now()) @db.Timestamp(0)
  interacoes                                   interacoes[]
  proposta_anexos                              proposta_anexos[]
  proposta_comentarios                         proposta_comentarios[]
  proposta_servicos                            proposta_servicos[]
  usuarios_propostas_orcamentista_idTousuarios usuarios?              @relation("propostas_orcamentista_idTousuarios", fields: [orcamentista_id], references: [id], map: "fk_propostas_orcamentista")
  clientes                                     clientes               @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "propostas_ibfk_1")
  usuarios_propostas_responsavel_idTousuarios  usuarios               @relation("propostas_responsavel_idTousuarios", fields: [responsavel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "propostas_ibfk_2")
  tarefas                                      tarefas[]

  @@index([cliente_id], map: "idx_propostas_cliente")
  @@index([follow_up_base_at], map: "idx_propostas_follow_up_base")
  @@index([orcamentista_id, status], map: "idx_propostas_orcamentista_status")
  @@index([responsavel_id, status], map: "idx_propostas_responsavel_status")
  @@index([status], map: "idx_propostas_status")
  @@index([status, created_at], map: "idx_propostas_status_created")
  @@index([status, kanban_order, created_at], map: "idx_propostas_status_kanban_created")
  @@index([updated_at], map: "idx_propostas_updated_at")
}

model realtime_updates {
  id            BigInt    @id @default(autoincrement())
  actor_user_id String?   @db.VarChar(36)
  resource      String    @db.VarChar(50)
  resource_id   String?   @db.VarChar(64)
  created_at    DateTime? @default(now()) @db.Timestamp(0)

  @@index([created_at, id], map: "idx_realtime_updates_created_id")
}

model schema_migrations {
  version      String   @id @db.VarChar(32)
  name         String   @db.VarChar(255)
  applied_at   DateTime @default(now()) @db.Timestamp(0)
  execution_ms Int?     @db.UnsignedInt
}

model tarefas {
  id              String          @id @db.VarChar(36)
  titulo          String?         @db.Text
  descricao       String?         @db.Text
  tipo            tarefas_tipo
  data_hora       DateTime        @db.DateTime(0)
  status          tarefas_status? @default(pendente)
  cliente_id      String          @db.VarChar(36)
  responsavel_id  String          @db.VarChar(36)
  created_at      DateTime?       @default(now()) @db.Timestamp(0)
  updated_at      DateTime?       @default(now()) @db.Timestamp(0)
  proposta_id     String?         @db.VarChar(36)
  automacao_etapa String?         @db.VarChar(50)
  origem          String          @default("manual") @db.VarChar(30)
  propostas       propostas?      @relation(fields: [proposta_id], references: [id], map: "fk_tarefas_proposta")
  clientes        clientes        @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tarefas_ibfk_1")
  usuarios        usuarios        @relation(fields: [responsavel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tarefas_ibfk_2")

  @@index([automacao_etapa, status, data_hora], map: "idx_tarefas_automacao_etapa_data")
  @@index([cliente_id], map: "idx_tarefas_cliente")
  @@index([cliente_id, status, data_hora], map: "idx_tarefas_cliente_status_data")
  @@index([data_hora], map: "idx_tarefas_data")
  @@index([proposta_id, origem, status], map: "idx_tarefas_proposta_origem_status")
  @@index([responsavel_id, status, data_hora], map: "idx_tarefas_responsavel_status_data")
  @@index([status], map: "idx_tarefas_status")
  @@index([updated_at], map: "idx_tarefas_updated_at")
}

model usuario_modulo_permissoes {
  user_id    String    @db.VarChar(36)
  module_key String    @db.VarChar(50)
  allowed    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  usuarios   usuarios  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_usuario_modulo_permissoes_usuario")

  @@id([user_id, module_key])
  @@index([module_key], map: "idx_usuario_modulo_permissoes_module")
}

model usuario_regra_permissoes {
  user_id    String    @db.VarChar(36)
  rule_key   String    @db.VarChar(80)
  allowed    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  usuarios   usuarios  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_usuario_regra_permissoes_usuario")

  @@id([user_id, rule_key])
  @@index([rule_key], map: "idx_usuario_regra_permissoes_rule")
}

model usuarios {
  id                                            String                      @id @db.VarChar(36)
  nome                                          String                      @db.VarChar(255)
  email                                         String                      @unique(map: "email") @db.VarChar(255)
  senha                                         String                      @db.VarChar(255)
  avatar                                        String?                     @db.VarChar(10)
  role                                          usuarios_role               @default(vendedor)
  ativo                                         Boolean?                    @default(true)
  module_permissions                            String?                     @db.LongText
  rule_permissions                              String?                     @db.LongText
  created_at                                    DateTime?                   @default(now()) @db.Timestamp(0)
  updated_at                                    DateTime?                   @default(now()) @db.Timestamp(0)
  meta_vendas                                   Decimal                     @default(0.00) @db.Decimal(15, 2)
  clientes                                      clientes[]
  interacoes                                    interacoes[]
  proposta_anexos                               proposta_anexos[]
  proposta_comentarios                          proposta_comentarios[]
  propostas_propostas_orcamentista_idTousuarios propostas[]                 @relation("propostas_orcamentista_idTousuarios")
  propostas_propostas_responsavel_idTousuarios  propostas[]                 @relation("propostas_responsavel_idTousuarios")
  tarefas                                       tarefas[]
  usuario_modulo_permissoes                     usuario_modulo_permissoes[]
  usuario_regra_permissoes                      usuario_regra_permissoes[]

  @@index([role, ativo, nome], map: "idx_usuarios_role_ativo_nome")
  @@index([updated_at], map: "idx_usuarios_updated_at")
}

enum tarefas_tipo {
  ligacao
  email
  reuniao
  visita
  outro
}

enum interacoes_tipo {
  ligacao
  email
  reuniao
  visita
  nota
  mudanca_status
  proposta
  tarefa
}

enum usuarios_role {
  admin
  gerente
  vendedor
  orcamentista
}

enum tarefas_status {
  pendente
  concluida
  atrasada
  cancelada
}

enum clientes_tipo {
  residencial
  comercial
}

enum clientes_origem {
  site
  indicacao
  google
  google_ads
  facebook
  instagram
  prospeccao
  telefone
  outro
}

enum clientes_status_funil {
  lead_novo
  em_atendimento
  orcamento_enviado
  negociacao
  fechado
  perdido
}

enum propostas_status {
  novo_cliente
  em_orcamento
  aguardando_aprovacao
  enviar_ao_cliente
  enviado_ao_cliente
  follow_up_1_dia
  aguardando_follow_up_3_dias
  follow_up_3_dias
  aguardando_follow_up_7_dias
  follow_up_7_dias
  stand_by
  em_retificacao
  fechado
  pos_fechamento
  perdido
}
